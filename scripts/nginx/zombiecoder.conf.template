# Copy only after replacing example.invalid and certificate paths.
# Keep the Node runtime bound to 127.0.0.1; expose only this TLS proxy.
server {
  listen 443 ssl;
  server_name example.invalid;
  ssl_certificate /etc/ssl/certs/example.invalid.pem;
  ssl_certificate_key /etc/ssl/private/example.invalid.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 4m;
  location / {
    proxy_pass http://127.0.0.1:9999;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_buffering off;
    proxy_read_timeout 3600s;
  }
}

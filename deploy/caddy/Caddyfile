# Local-only audio file server for ZombieCoder reports.
#
# The runtime itself is API-only and binds loopback. This Caddy instance does
# one job: serve the directory that holds the generated MP3/transcript/SRT.
# It is not a public web server and intentionally has no admin API.
#
#   CADDY_AUDIO_ROOT  directory to serve (default: /home/sahon/Music/work mp3)
#   CADDY_AUDIO_PORT  loopback port (default: 8090)
#
# Run:   caddy run --config deploy/caddy/Caddyfile --adapter caddyfile
# Check: caddy validate --config deploy/caddy/Caddyfile --adapter caddyfile

{
	admin off
	auto_https off
}

http://127.0.0.1:{$CADDY_AUDIO_PORT:8090} {
	root * "{$CADDY_AUDIO_ROOT:/home/sahon/Music/work mp3}"
	file_server browse

	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}

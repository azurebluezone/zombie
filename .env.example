# ============================================================
# ZombieCoder Runtime v0.46 — environment example
# ============================================================
# Copy this file to .env and change secrets/URLs/models.
# Do not commit a real .env file or real API keys.

# ---------------- Runtime ----------------
HOST=127.0.0.1
PORT=9999
ADMIN_TOKEN=replace-with-a-long-random-admin-token
RUNTIME_SECRET=replace-with-a-long-random-runtime-secret
ALLOW_PLAINTEXT_HTTP=false
# Safe default: chat only. Change to tools-enabled only after the deployment verification loop passes.
ZOMBIECODER_EXECUTION_MODE=chat-only
DATA_DIR=./data
SQLITE_PATH=./data/runtime.sqlite
MIGRATE_JSON_ON_START=false

# Optional HTTPS / UDS
HTTPS_ENABLED=false
HTTPS_REQUIRED=false
HTTPS_HOST=127.0.0.1
HTTPS_PORT=10443
HTTPS_KEY=./certs/server.key
HTTPS_CERT=./certs/server.crt
UDS_ENABLED=false
UDS_REQUIRED=false
UDS_PATH=./data/runtime.sock

# ---------------- Provider routing ----------------
# The runtime is provider-neutral. Add providers through PROVIDER_CONFIG_JSON.
# API keys are looked up as PROVIDER_KEY_<PROVIDER_ID>, with '_' normalized to '-'.
# Example: provider id "opencode-free" -> PROVIDER_KEY_OPENCODE_FREE

# Default self-hosted OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Private provider destinations are denied by default. To reach a self-hosted Ollama while
# still allowing public providers, explicitly opt in for the exact loopback host:
# PROVIDER_ALLOW_PRIVATE_NETWORK=true
# PROVIDER_ALLOW_PRIVATE_HOSTS=127.0.0.1

PROVIDER_KEY_OLLAMA_SELFHOSTED=

# Ollama Cloud: OpenAI-compatible endpoint (/v1).
# Put your Ollama Cloud key here if you want to test the cloud endpoint.
PROVIDER_KEY_OLLAMA_CLOUD_OPENAI=

# Ollama Cloud: native Ollama API (/api/*). The adapter sends the same bearer key.
PROVIDER_KEY_OLLAMA_CLOUD_NATIVE=

# Ollama's own documented key name. Optional: it is used as a fallback for every
# provider whose configured driver is "ollama" when no PROVIDER_KEY_<ID> is set,
# so a single OLLAMA_API_KEY can serve a self-hosted and a cloud Ollama together. An
# explicit PROVIDER_KEY_* always takes precedence.
OLLAMA_API_KEY=

# Native Gemini driver uses the Gemini generateContent API.
PROVIDER_KEY_GEMINI=

# Groq uses its OpenAI-compatible API.
PROVIDER_KEY_GROQ=

# Cloudflare Workers AI OpenAI-compatible endpoint.
# Replace YOUR_ACCOUNT_ID with the real Cloudflare account id.
PROVIDER_KEY_CLOUDFLARE=

# OpenCode-compatible/custom OpenAI-compatible endpoint.
# The runtime does not assume a provider-owned endpoint here; put the actual
# endpoint supplied by your provider/gateway in the config below.
PROVIDER_KEY_OPENCODE_FREE=

# Generic custom OpenAI-compatible provider.
PROVIDER_KEY_CUSTOM_1=

# Provider bootstrap. Keep optional providers disabled until their endpoint,
# model, credentials, and network policy are actually configured and tested.
# JSON is intentionally one line because .env parsing differs between loaders.
PROVIDER_CONFIG_JSON=[{"id":"ollama-selfhosted","name":"Ollama Self-Hosted","driver":"ollama","protocol":"openai-compatible","baseUrl":"http://127.0.0.1:11434/v1","defaultModel":"REPLACE_WITH_OLLAMA_MODEL","models":[],"enabled":true,"capabilities":["chat-completions","streaming","function-calling","model-catalog"],"priority":1},{"id":"ollama-cloud-openai","name":"Ollama Cloud OpenAI Compatible","driver":"ollama","mode":"openai-compatible","protocol":"openai-compatible","baseUrl":"https://ollama.com/v1","defaultModel":"REPLACE_WITH_OLLAMA_CLOUD_MODEL","models":[],"enabled":false,"capabilities":["chat-completions","streaming","function-calling","model-catalog"],"priority":2},{"id":"ollama-cloud-native","name":"Ollama Cloud Native","driver":"ollama","mode":"native","protocol":"ollama-native","baseUrl":"https://ollama.com","defaultModel":"REPLACE_WITH_OLLAMA_CLOUD_MODEL","models":[],"enabled":false,"capabilities":["chat-completions","streaming","function-calling","model-catalog"],"priority":3},{"id":"gemini","name":"Google Gemini","driver":"gemini","protocol":"gemini-generate-content","baseUrl":"https://generativelanguage.googleapis.com/v1beta","defaultModel":"REPLACE_WITH_SUPPORTED_GEMINI_MODEL","models":[],"enabled":false,"capabilities":["generate-content","streaming","function-calling","model-catalog"],"priority":4},{"id":"groq","name":"Groq","driver":"groq","protocol":"openai-compatible","baseUrl":"https://api.groq.com/openai/v1","defaultModel":"REPLACE_WITH_SUPPORTED_GROQ_MODEL","models":[],"enabled":false,"capabilities":["chat-completions","streaming","function-calling","model-catalog"],"priority":5},{"id":"cloudflare","name":"Cloudflare Workers AI","driver":"cloudflare","protocol":"openai-compatible","baseUrl":"https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1","defaultModel":"REPLACE_WITH_SUPPORTED_CLOUDFLARE_MODEL","models":[],"enabled":false,"capabilities":["chat-completions","streaming","function-calling","model-catalog"],"priority":6},{"id":"opencode-free","name":"OpenCode Compatible Endpoint","driver":"openai-compatible","protocol":"openai-compatible","baseUrl":"https://REPLACE_WITH_OPENCODE_COMPATIBLE_ENDPOINT/v1","defaultModel":"REPLACE_WITH_SUPPORTED_MODEL","models":[],"enabled":false,"capabilities":["chat-completions","streaming","function-calling","model-catalog"],"priority":7},{"id":"custom-1","name":"Custom Provider 1","driver":"openai-compatible","protocol":"openai-compatible","baseUrl":"https://REPLACE_WITH_CUSTOM_ENDPOINT/v1","defaultModel":"REPLACE_WITH_SUPPORTED_MODEL","models":[],"enabled":false,"capabilities":["chat-completions","streaming","function-calling","model-catalog"],"priority":8}]

# Optional provider catalog sync (remote catalog must itself be trusted/allowed).
PROVIDER_CATALOG_SYNC_URL=
PROVIDER_CATALOG_SYNC_ON_START=false
# Refresh each provider's model list from its /models endpoint during startup bootstrap.
PROVIDER_MODELS_REFRESH_ON_START=false
# Per-provider budget for that startup refresh; a slow provider never blocks boot.
PROVIDER_MODELS_REFRESH_TIMEOUT_MS=8000
PROVIDER_CATALOG_API_KEY=
PROVIDER_SYNC_TIMEOUT_MS=30000
# Socket inactivity budget for one provider chat/models call. Raise it when a
# a self-hosted runtime needs longer than 30s to load a model before the first byte.
PROVIDER_TIMEOUT_MS=30000

# ---------------- Network policy ----------------
PROVIDER_ALLOW_HOSTS=
PROVIDER_ALLOW_PRIVATE_NETWORK=false
PROVIDER_ALLOW_PRIVATE_HOSTS=
MAX_PROVIDER_RESPONSE_BYTES=4194304
MAX_BODY_BYTES=4194304

# ---------------- MCP ----------------
MCP_CONNECTION_LEASE_MS=300000
MCP_RECONCILE_ON_START=false
# Discover the tool list of every declared MCP endpoint during startup. It is
# bounded per endpoint and best-effort, and it is what makes a freshly copied
# package report real tools instead of an empty catalog.
EXTERNAL_MCP_DISCOVER_ON_START=true
# Also re-discover endpoints that already have persisted tools from an earlier run.
EXTERNAL_MCP_REFRESH_TOOLS_ON_START=false
EXTERNAL_MCP_DISCOVER_TIMEOUT_MS=10000
MCP_RECONCILIATION_GRACE_MS=30000
EXTERNAL_MCP_URLS=
# Named Streamable HTTP MCP endpoints: EXTERNAL_MCP_<ID>_URL registers endpoint id <id>.
# EXTERNAL_MCP_UNIVERSAL_URL=http://127.0.0.1:5400/mcp
# The host allowlist below must include every declared host, or registration is refused.

# Inbound MCP server (opt-in). When true the runtime serves Streamable HTTP MCP on
# POST /mcp (initialize / tools/list / tools/call), authenticated by an application
# API key. Tool calls still pass the application tool-permission check and stay
# inside the project-root sandbox. Default false keeps the runtime client-only.
# MCP_SERVER_ENABLED=true
# MCP_SERVER_PROJECT_ROOT=
# Inbound MCP authentication: `required` (default) needs an application key on
# POST /mcp; `disabled` accepts unauthenticated calls and signs them in as
# an auto-provisioned application so sessions/audit still have an owner.
# The admin console can override this at runtime without a restart.
# MCP_SERVER_AUTH=required
# EXTERNAL_MCP_PUBLIC_API_URL=https://example.invalid/mcp
# EXTERNAL_MCP_TTS_URL=https://example.invalid/mcp
# EXTERNAL_MCP_OCR_URL=https://example.invalid/mcp
# EXTERNAL_MCP_FACEBOOK_ADS_URL=https://example.invalid/mcp
#
# TLS trust for outbound MCP endpoints. An internal server usually presents a
# certificate signed by an internal CA, or a self-signed one; Node verifies
# certificates by default, so without a CA the connection fails before the MCP
# handshake with DEPTH_ZERO_SELF_SIGNED_CERT / UNABLE_TO_VERIFY_LEAF_SIGNATURE.
# Point MCP_TLS_CA_FILE at a PEM bundle to trust it. A per-endpoint `caFile` or
# inline `ca` (set through the admin API) wins over this global value.
# MCP_TLS_CA_FILE=/etc/ssl/certs/internal-ca.pem
# Last resort only: skip certificate verification entirely. Never the default,
# and the decision is reported so it cannot be switched on silently.
# MCP_TLS_INSECURE=false

# ---------------- Tool / execution limits ----------------
TOOL_LOOP_MAX_ROUNDS=8
TOOL_LOOP_MAX_TOOL_CALLS_PER_ROUND=8
TOOL_LOOP_MAX_REPEATED_CALLS=2
SESSION_MAX_MESSAGES=100
# Tool access mode. `permissioned` (default) keeps the per-application grant store
# as the authority: an application may only call a tool an operator granted it.
# `unrestricted` drops that gate so every agent can call every runnable tool; a
# tool disabled by configuration is still refused, and each agent's persisted
# tool-access scope (global | working-directory) still bounds where tools operate.
TOOL_ACCESS_MODE=permissioned
# What an agent is *offered* (narrowed|full). narrowed shows only the tools the request
# needs plus a small always-on set. It never changes what is *allowed*.
TOOL_SURFACE_MODE=narrowed
# Hard cap on the narrowed surface; the always-on core tools always survive it.
TOOL_SURFACE_MAX=12
# How many tools discovered on external MCP endpoints may be offered in one
# request. A discovered endpoint can expose dozens of tools; without a cap a
# single endpoint would dominate the surface the model sees. 0 disables them.
EXTERNAL_TOOL_SURFACE_MAX=16
ZOMBIECODER_TOOLS=
# ZOMBIECODER_TOOL_READ_FILE=true
# ZOMBIECODER_TOOL_WRITE_FILE=false

# ---------------- Session / context ----------------
MEMORY_MAX_ENTRIES=500
CONTEXT_BUDGET_BYTES=1048576
COMPILED_CONTEXT_BYTES=20480
CONTEXT_RECENT_MESSAGES=10
PROJECT_ROOTS=

# ---------------- Observability ----------------
ENV_FILE=.env
ENV_LOADER_ENABLED=true
LOG_LEVEL=info
LOG_DIR=./logs
LOG_FILE=runtime.jsonl
LOG_TO_STDOUT=true
LOG_MAX_BYTES=10485760
# Number of numbered archives to retain in addition to the active log file.
LOG_MAX_FILES=7
# Keep false to omit conversation/tool payloads from logs.
LOG_PAYLOADS=false
# Write a `runtime.memory` line (heap + RSS) every N ms; the startup line is always written.
# 0 turns the periodic line off and keeps the startup snapshot.
MEMORY_LOG_INTERVAL_MS=60000

# ---------------- Reliability ----------------
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_TIMEOUT_MS=15000
CIRCUIT_HALF_OPEN_MAX_CALLS=1

# ---------------- Optional browser/CDP ----------------
CDP_USER_DATA_DIR=
CDP_SYNC_URL=

# ---------------- Instance identity ----------------
RUNTIME_ID=
INSTANCE_ID=

# External MCP security policy. Defaults deny plaintext HTTP and private destinations.
MCP_ALLOW_HTTP=false
MCP_ALLOW_PRIVATE_NETWORK=false
# Exact host allowlist, comma-separated; required with HTTP/private MCP access.
MCP_ALLOW_HOSTS=

# Explicit loopback-only admin bypass; never enable behind a reverse proxy.
LOOPBACK_AUTH_BYPASS=false

# Browser CORS allowlist (comma-separated absolute origins). Empty = same-origin only.
# Example: CORS_ALLOW_ORIGINS=https://him.zombiecoder.my.id
CORS_ALLOW_ORIGINS=

# TLS material for the HTTPS transport. Generate them with openssl; never commit them.
# See certs/README.md and scripts/systemd/README.md.
# HTTPS_ENABLED=true
# HTTPS_HOST=127.0.0.1
# HTTPS_PORT=10443
# HTTPS_KEY=./certs/server.key
# HTTPS_CERT=./certs/server.crt
